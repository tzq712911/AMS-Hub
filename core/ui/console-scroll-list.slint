import { ConsoleButton } from "console-theme.slint";

// Explicit viewport geometry is essential on the MCU; layout compression must
// never make a long catalogue look like a short, non-scrollable list.
export component ConsoleScrollList inherits Rectangle {
    in property <int> row-count;
    in property <length> row-height: 44px;
    out property <length> scroll-offset: flick.viewport-y;
    out property <length> content-width: flick.width;
    // Window the rows in users of this component; only visible buttons are built.
    out property <int> first-row: max(0,floor(-flick.viewport-y / root.row-height)-1);
    out property <int> visible-row-count: max(0,min(root.row-count - root.first-row,ceil(self.height/root.row-height)+3));
    clip: true;
    flick := Flickable {
        x:0px;y:0px;
        width: parent.width - 44px;
        height: parent.height;
        viewport-width: self.width;
        viewport-height: max(self.height, root.row-count * root.row-height);
        @children
    }
    ConsoleButton {
        x: parent.width - 40px; y:0px; width: 40px; height: parent.height / 2 - 3px;
        text: "▲";
        clicked => { flick.viewport-y = min(0px, flick.viewport-y + flick.height * 0.75); }
    }
    ConsoleButton {
        x: parent.width - 40px; y: parent.height / 2 + 3px;
        width: 40px; height: parent.height / 2 - 3px; text: "▼";
        clicked => { flick.viewport-y = max(min(0px, flick.height - flick.viewport-height), flick.viewport-y - flick.height * 0.75); }
    }
}

