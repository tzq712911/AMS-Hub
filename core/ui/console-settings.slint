import { ConsoleTheme, ConsoleButton, ConsoleLabel } from "console-theme.slint";
import { FrameworkState, FrameworkBackend, WebConfigState } from "framework/framework.slint";
import { AppState } from "app.slint";
import { HubUi } from "hub.slint";

export component ConsoleSettings inherits Rectangle {
    callback back;
    property <bool> show-key: false;
    background: ConsoleTheme.background;
    VerticalLayout {
        padding: 10px; spacing: 8px;
        HorizontalLayout {
            height: 36px; spacing: 8px;
            ConsoleButton { width: 48px; text: "‹"; clicked => { root.back(); } }
            ConsoleLabel { text: "连接与设置"; font-size: 21px; }
            ConsoleLabel { text: FrameworkState.app-info.version; color: ConsoleTheme.muted; horizontal-alignment: right; font-size: 13px; }
        }
        Rectangle {
            background: ConsoleTheme.panel; border-radius: 12px;
            VerticalLayout {
                padding: 12px; spacing: 4px;
                ConsoleLabel { text: "打印机"; color: ConsoleTheme.muted; font-size: 13px; height: 22px; }
                ConsoleLabel { text: AppState.curr-printer == "" ? "尚未配置" : AppState.curr-printer; height: 24px; }
                ConsoleLabel { text: "在手机或电脑浏览器打开下方地址进行连接配置"; font-size: 13px; wrap: word-wrap; height: 32px; }
                ConsoleLabel { text: FrameworkState.web-config-url; color: ConsoleTheme.accent; height: 26px; }
                ConsoleLabel { text: "Wi-Fi：" + FrameworkState.web-config-ssid; font-size: 13px; color: ConsoleTheme.muted; height: 22px; }
                HorizontalLayout {
                    height: 32px; spacing: 8px;
                    ConsoleLabel { text: root.show-key ? "访问密钥：" + FrameworkState.web-config-key : "访问密钥：•••••••"; font-size: 14px; }
                    ConsoleButton { width: 65px; text: root.show-key ? "隐藏" : "显示"; clicked => { root.show-key = !root.show-key; } }
                }
            }
        }
        HorizontalLayout {
            ConsoleButton {
                text: "开启网络配置"; primary: true; height: 40px;
                clicked => {
                    if FrameworkState.web-config-state != WebConfigState.Started-AP {
                        FrameworkState.web-config-state = WebConfigState.Starting;
                        FrameworkBackend.start-web-config();
                    }
                    root.show-key = true;
                }
            }
            ConsoleButton { text: "返回耗材"; primary: true; height: 40px; clicked => { root.back(); } }
        }
    }
}
