import { ConsoleTheme } from "console-theme.slint";
// Desktop fixture only. These values are not printer telemetry.
import { ConsoleResultTimer } from "console-result-timer.slint";
import { ConsoleHome } from "console-home.slint";
import { ConsoleEditor } from "console-editor.slint";
import { ConsoleSettings } from "console-settings.slint";
import { HubPage, HubUi, HubSlot } from "hub.slint";
import { AppState, AppBackend, ControlState, UiTrayState, UiFilamentState, SpoolStagingState, UiConsolePreset, UiConsoleColor, UiSpoolRecordDisplay, UiSlotDisplay } from "app.slint";
import "fonts/ConsoleSans.ttf";
import { RuntimeGlyphs } from "runtime-glyphs.slint";
import { ConsoleScrollList } from "console-scroll-list.slint";
import { ConsoleButton } from "console-theme.slint";
import { Terminal } from "framework/terminal.slint";
import { FrameworkState, FrameworkBackend, WebConfigState } from "framework/framework.slint";

export { AppState, AppBackend }
export { HubUi, HubSlot }
export { FrameworkState, FrameworkBackend, WebConfigState }

export component ConsolePreview inherits Window {
    out property <string> runtime-font-coverage: RuntimeGlyphs.characters;
    out property <length> terminal-scroll-offset: terminal.scroll-offset-from-end;
    in-out property <[string]> list-test-values;
    in-out property <int> list-test-choice: -1;
    out property <length> list-test-offset: scroll-test.scroll-offset;
    title: "SpoolEase Console · UI Preview";
    width: 480px; height: 320px;
    ConsoleResultTimer {}
    default-font-family: "Console Sans";
    in-out property <int> preview-mode: 0;
    in-out property <bool> hub-mode: false;
    in-out property <string> simulation-log;
    out property <UiConsoleColor> color-template:{name:"",code:"",tint:#555555};
    out property <UiConsolePreset> preset-template:{brand:"Generic",code:"",name:"",material:"",temp-min:0,temp-max:0};
    public function scan-demo(petg: bool) {
        AppState.control-state = ControlState.Ready;
        AppState.spool-staging-state = SpoolStagingState.Scanned;
        AppState.spool-staging-info = {
            spool-record: { id:petg?"002":"001", material-type:petg?"PETG":"PLA", color-code:petg?"71CCE1FF":"00CE9BFF", slicer-filament:petg?"GFG99":"GFA00",ext-has-k:false },
            color:petg?#71cce1:#00ce9b, slicer-filament-name:petg?"Generic PETG":"Bambu PLA Basic",temp-min:petg?220:190,temp-max:petg?270:240
        };
    }
    public function home() { root.preview-mode=0; AppState.control-state=ControlState.Ready; }
    public function show-message(message:string) { AppState.user-message=message; AppState.control-state=ControlState.PostAction; }
    public function simulate-slot(tray-id:int, material:string, tint:color) {
        if tray-id>=0 && tray-id<4 { AppState.trays-state[tray-id+2].filament = {state:UiFilamentState.Known,material:material,color:tint}; }
    }
    public function simulate-bambu-profile(tray-id:int,material:string,tint:color,vendor:string) {
        root.simulate-slot(tray-id,material,tint);
        if tray-id>=0&&tray-id<4{AppState.trays-state[tray-id+2].brand=vendor;}
    }
    public function multi-ams-demo() { root.home();HubUi.visible=false;HubUi.active-brand=0;AppState.ams-exists=[0,1,2,3,4,5]; }
    public function load-hub-demo(profile:int, locked:bool) {
        HubUi.connected=true;HubUi.devices=["U1-A","U1-B"];HubUi.device-ids=["device-a","device-b"];HubUi.selected-device=0;
        HubUi.active-brand=profile;
        HubUi.brand-name=profile==1?"Snapmaker U1":"Anycubic ACE";
        HubUi.host="192.0.2.10 · 模拟地址";
        HubUi.slots=[
            {box-id:0,index:0,label:"槽 1",base-material:"PLA",preset-code:"GFA99",temp-min:190,temp-max:240,material:"PLA",brand:"SUNLU",tint:#00ce9b,rgba:"00CE9BFF",locked:profile==1&&locked},
            {box-id:0,index:1,label:"槽 2",base-material:"PLA",preset-code:"GFA99",temp-min:190,temp-max:240,material:"PLA",brand:"eSUN",tint:#71cce1,rgba:"71CCE1FF",locked:false},
            {box-id:0,index:2,label:"槽 3",base-material:"PLA",preset-code:"GFA99",temp-min:190,temp-max:240,material:"PLA",brand:"Polymaker",tint:#f01b23,rgba:"F01B23FF",locked:false},
            {box-id:0,index:3,label:"槽 4",base-material:"PETG",preset-code:"GFG99",temp-min:220,temp-max:270,material:"PETG",brand:"Generic",tint:#ffffff,rgba:"FFFFFFFF",locked:false}
        ];
    }
    public function simulate-hub-slot(index:int,material:string,rgba:string) {
        HubUi.slots[index].material=material;
        HubUi.slots[index].label="槽 "+(index+1)+" · "+material;
        HubUi.slots[index].rgba=rgba;
    }
    public function simulate-hub-profile(index:int,info:UiSpoolRecordDisplay,machine:string) {
        HubUi.slots[index].material=info.slicer-filament-name;
        HubUi.slots[index].base-material=info.spool-record.material-type;
        HubUi.slots[index].brand=info.spool-record.brand;
        HubUi.slots[index].rgba=info.spool-record.color-code;
        HubUi.slots[index].tint=info.color;
        HubUi.slots[index].preset-code=info.spool-record.slicer-filament;
        HubUi.slots[index].series-name=info.spool-record.material-subtype;
        HubUi.slots[index].temp-min=info.temp-min;
        HubUi.slots[index].temp-max=info.temp-max;
        HubUi.slots[index].machine-detail=machine;
    }
    public function scan-record(tag:string,brand:string,material:string,rgba:string,tint:color,preset:string,minimum:int,maximum:int,series:string) {
        root.home();AppState.spool-staging-state=SpoolStagingState.Scanned;
        AppState.spool-staging-info={spool-record:{tag-id:tag,id:tag,brand:brand,material-type:material,color-code:rgba,slicer-filament:preset,material-subtype:series},color:tint,slicer-filament-name:series,temp-min:minimum,temp-max:maximum};
    }
