        AppState.spool-staging-info = { spool-record: { id: "001", brand:"Bambu Lab", material-type: "PLA", color-code: "00CE9BFF", slicer-filament: "GFA00", ext-has-k: true }, color: #00ce9b, slicer-filament-name: "Bambu PLA Basic", temp-min: 190, temp-max: 240 };
    }
    if !hub-mode && !HubUi.visible && preview-mode == 0 && AppState.control-state != ControlState.TraySelected && AppState.control-state != ControlState.NewTagScan: ConsoleHome { settings=>{root.preview-mode=3;} }
    if !hub-mode && !HubUi.visible && (preview-mode == 1 || (preview-mode == 0 && AppState.control-state == ControlState.TraySelected)): ConsoleEditor {width:480px;height:320px;}
    if preview-mode == 2 || AppState.control-state == ControlState.NewTagScan: ConsoleEditor {width:480px;height:320px;registration-mode:true;}
    if preview-mode == 3: ConsoleSettings {back=>{root.home();}}
    if (hub-mode || HubUi.visible) && preview-mode != 3 && preview-mode != 2 && AppState.control-state != ControlState.NewTagScan: HubPage { }
    if HubUi.settings-open: ConsoleSettings {back=>{HubUi.settings-open=false;}}
    if HubUi.editing: ConsoleEditor {width:480px;height:320px;}
    terminal := Terminal {
        visible: root.preview-mode == 4;
        width: 480px; height: 320px;
        background: #16161e;
        text: FrameworkState.term-text;
        configure => { root.preview-mode = 3; }
    }
    scroll-test := ConsoleScrollList {
        visible: root.preview-mode == 5;
        width:480px;height:320px;
        row-count:root.list-test-values.length;
        for item[index] in root.list-test-values: ConsoleButton {
            y:index*44px;width:scroll-test.content-width;height:40px;text:item;
            clicked=>{root.list-test-choice=index;}
        }
    }
}

export { ConsoleTheme }
