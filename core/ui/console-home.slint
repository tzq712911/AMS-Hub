import { AppState, AppBackend, ControlState, SpoolStagingState, UiTray, UiTrayState, UiFilamentState } from "app.slint";
import { ConsoleTheme, ConsoleButton, ConsoleLabel } from "console-theme.slint";
import { HubUi, BrandTabs } from "hub.slint";
import { ScrollView } from "std-widgets.slint";

component SlotCard inherits Rectangle {
    in property <UiTray> tray;
    in property <string> label;
    callback clicked;
    background: ConsoleTheme.panel;
    border-radius: 10px;
    border-width: touch.pressed || tray.used-in-print ? 2px : 0px;
    border-color: ConsoleTheme.accent;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        ConsoleLabel { text: root.label; horizontal-alignment: center; font-size: 14px; color: ConsoleTheme.muted; height: 20px; }
        HorizontalLayout {
          alignment: center;
          spool := Rectangle {
            horizontal-stretch: 0;
            width: 46px; height: 46px;
            border-radius: 23px;
            background: root.tray.filament.state == UiFilamentState.Known ? root.tray.filament.color : #555555;
            border-width: 4px; border-color: #777777;
            Rectangle {
                x: 17px; y: 17px; width: 12px; height: 12px;
                border-radius: 6px; background: #343434;
            }
          }
        }
        ConsoleLabel {
            height: 28px;
            text: root.tray.filament.state == UiFilamentState.Known ? root.tray.filament.material : "未设置";
            font-size:17px * ConsoleTheme.text-scale;
            horizontal-alignment: center;
        }
        ConsoleLabel {
            height: 18px; font-size: 12px;
            horizontal-alignment: center;
            color: root.tray.spool-state == UiTrayState.Loaded ? ConsoleTheme.accent : ConsoleTheme.muted;
            text: root.tray.brand == "" ? "品牌未记录" : root.tray.brand;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component ConsoleHome inherits Rectangle {
    callback settings;
    callback printers;
    background: ConsoleTheme.background;
    property <bool> staged: AppState.spool-staging-state != SpoolStagingState.Empty;
    property <int> side-ht: AppState.ams-exists.length==2 && AppState.curr-ams-id<=3 ? (AppState.ams-exists[0]>3?AppState.ams-exists[0]:AppState.ams-exists[1]>3?AppState.ams-exists[1]:-1) : -1;
    property <int> card-count: AppState.ams-exists.length==0?1:AppState.curr-ams-id<=3?(side-ht>=0?5:4):1;
    property <string> action-error;
    VerticalLayout {
        padding: 10px; spacing: 8px;
        HorizontalLayout {
            height: 34px; spacing: 8px;
            BrandTabs {}
            Rectangle {clip:true;Flickable {width:parent.width;height:parent.height;viewport-height:self.height;viewport-width:max(self.width,AppState.available-printers.length*110px);
                HorizontalLayout {spacing:4px;for printer in AppState.available-printers: ConsoleButton {
                    width:106px;height:32px;text:AppBackend.console-text(printer);primary:printer==AppState.curr-printer;
                    clicked=>{AppBackend.select-printer(printer);}
                }}
            }}
            ConsoleButton { width:54px;text:"设置";clicked=>{root.settings();} }
        }
        HorizontalLayout {height:42px;spacing:6px;
            ConsoleLabel {width:66px;text:AppState.selected-printer-connected?"● 已连接":"○ 未连接";font-size:11px;color:AppState.selected-printer-connected?ConsoleTheme.accent:ConsoleTheme.muted;}
            Rectangle {clip:true;Flickable {width:parent.width;height:parent.height;viewport-height:self.height;viewport-width:max(self.width,AppState.ams-exists.length*94px);
                HorizontalLayout {height:42px;spacing:4px;
                    for ams-id in AppState.ams-exists: Rectangle {
                        width:90px;height:42px;border-radius:6px;background:AppState.curr-ams-id==ams-id?ConsoleTheme.field:ConsoleTheme.panel;
                        border-width:AppState.curr-ams-id==ams-id?1px:0px;border-color:ConsoleTheme.accent;
                        ConsoleLabel {x:4px;y:0px;width:82px;height:20px;text:ams-id>3?"HT "+(ams-id - 3):"AMS "+(ams-id+1);font-size:12px;horizontal-alignment:center;}
                        HorizontalLayout {x:6px;y:23px;width:78px;height:12px;spacing:3px;alignment:center;
                            for slot in (ams-id<=3?[0,1,2,3]:[0]): Rectangle {
                                width:16px;height:12px;border-radius:3px;
                                background:AppState.trays-state[AppState.get-tray-index(ams-id,slot)].filament.state==UiFilamentState.Known?AppState.trays-state[AppState.get-tray-index(ams-id,slot)].filament.color:#555;
                            }
                        }
                        TouchArea {clicked=>{AppState.curr-ams-id=ams-id;}}
                    }
                }
            }}
            for extruder in (AppState.num-extruders==2?[0,1]:[AppState.displayed-extruder]): ConsoleButton {width:44px;height:32px;text:AppState.num-extruders==1?"外置":extruder==0?"外右":"外左";clicked=>{AppState.displayed-extruder=extruder;AppState.tray-selected(extruder);}}
        }
        HorizontalLayout {
            height: 147px; spacing: 7px;
            for slot in (AppState.ams-exists.length == 0 ? [] : AppState.curr-ams-id <= 3 ? [0,1,2,3] : [0]): SlotCard {
                width: (460px - (root.card-count - 1) * 7px) / root.card-count;
                tray: AppState.trays-state[AppState.get-tray-index(AppState.curr-ams-id, slot)];
                label: "槽位 " + (slot + 1);
                clicked => { AppState.tray-selected(AppState.get-tray-index(AppState.curr-ams-id, slot)); }
            }
            if root.side-ht>=0: SlotCard {
                width:(460px - 28px)/5;
                tray:AppState.trays-state[AppState.get-tray-index(root.side-ht,0)];label:"HT "+(root.side-ht - 3);
                clicked=>{AppState.tray-selected(AppState.get-tray-index(root.side-ht,0));}
            }
            if AppState.ams-exists.length==0: SlotCard {
                tray:AppState.trays-state[AppState.displayed-extruder];label:"外置";
                clicked=>{AppState.tray-selected(AppState.displayed-extruder);}
            }
        }
        Rectangle {
            background: ConsoleTheme.panel; border-radius: 9px;
            HorizontalLayout {
                padding: 9px; spacing: 8px;
                Rectangle { width: 5px; border-radius: 2px; background: root.staged ? AppState.spool-staging-info.color : ConsoleTheme.accent; }
                VerticalLayout {
                    ConsoleLabel { text: AppState.control-state == ControlState.PostAction || AppState.control-state == ControlState.BootFailed ? AppState.user-message + (AppState.control-state==ControlState.PostAction?" · "+AppState.post-action-remaining+"秒后待扫描":"") : root.action-error!=""?root.action-error:root.staged ? "已识别 · " + AppState.spool-staging-info.spool-record.material-type : AppState.control-state == ControlState.Reading ? "正在读取标签…" : "将耗材标签靠近读卡区"; font-size: 14px; wrap: word-wrap; }
                    if AppState.control-state != ControlState.PostAction && AppState.control-state != ControlState.BootFailed: ConsoleLabel { text: root.staged ? "等待装料 · 自动识别槽位，也可点击手动设置" : "未知标签可在屏幕建档"; font-size: 12px; color: ConsoleTheme.muted; }
                }
                if root.staged: ConsoleButton { width: 58px; text: "清除"; clicked => { AppBackend.clear-staging(); } }
                ConsoleButton {width:78px;text:"重设 RFID";enabled:root.staged&&AppState.spool-staging-info.spool-record.tag-id!="";clicked=>{root.action-error=AppBackend.reassign-scanned-tag();}}

            }
        }
    }
}
